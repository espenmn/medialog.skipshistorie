<html xmlns="http://www.w3.org/1999/xhtml"
  xmlns:tal="http://xml.zope.org/namespaces/tal"
  xmlns:i18n="http://xml.zope.org/namespaces/i18n" i18n:domain="plone" tal:omit-tag="">

  <body tal:define="off_nr context/off_nr|None">

    <aside class="portlet portletMetadata">
      <header class="portletHeader">
        <span>Teknisk info</span>
      </header>
      <p>

        <ul>
          <li tal:condition="off_nr|None">
            <b>IMO/off_nr: </b>${off_nr|None}</li>
          <li tal:condition="view/related_ships|None">
            <b>Samme IMO: </b>
            <ul>
              <li tal:repeat="ship view/related_ships">
                <a href="${ship/getURL}" alt="lenke til ship">${ship/Title}</a>
              </li>
            </ul>
          </li>
          <li tal:condition="context/flagg|None">
            <b>Flagg: </b>${context/flagg|None}</li>
          <li tal:condition="context/havn|None">
            <b>Havn: </b>${context/havn|None}</li>
          <li tal:condition="context/kallesignal|None">
            <b>Kallesignal: </b>${context/kallesignal|None}</li>
          <li tal:condition="view/related_kallesignal|None">
            <b>Samme Kallesignal: </b>
            <ul>
              <li tal:repeat="ship view/related_kallesignal">
                <a href="${ship/getURL}" alt="lenke til ship">${ship/Title}</a>
              </li>
            </ul>
          </li>
        </ul>
      </p>

    </aside>
    <aside>
      <p>
        <a class="button standalone" href="${context/absolute_url}/toPDF">Get PDF</a>
        <tal:check tal:condition="off_nr|None"> 
          <a tal:condition="python: len(off_nr) > 7" 
            class="button standalone" 
            href="https://www.vesselfinder.com/vessels/details/${off_nr}">Try Vesselfinder</a>
        </tal:check>
      </p>
      <p>&nbsp;</p>
    </aside>
  </body>

</html>
<style>
  .portletMetadata ul ul {padding-left: 0.9em}
  .pre {
  white-space: pre-wrap;       /* css-3 */
  white-space: -moz-pre-wrap;  /* Mozilla, since 1999 */
  white-space: -pre-wrap;      /* Opera 4-6 */
  white-space: -o-pre-wrap;    /* Opera 7 */
  word-wrap: break-word;       /* Internet Explorer 5.5+ */
  padding-bottom: 0;
  margin-bottom: 0;
  }
</style>
